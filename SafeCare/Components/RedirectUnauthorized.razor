@using Microsoft.AspNetCore.Components.Authorization
@using SafeCare.Utils
@inject NavigationManager NavigationManager

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            RedirectToLogin();
            return;
        }

        var authState = await AuthenticationState;
        var isAuthenticated = authState.User.Identity?.IsAuthenticated == true;

        if (isAuthenticated)
        {
            // A session without a second factor is refused everywhere by the default policy;
            // the only thing it can do is set two-factor authentication up. Sending it to the
            // dashboard instead would bounce it straight back here, forever.
            var hasSecondFactor = authState.User.HasClaim(
                AuthPolicies.AuthenticationMethodClaim, AuthPolicies.MultiFactorAuthenticationMethod);

            NavigationManager.NavigateTo(hasSecondFactor ? "/dashboard" : "/account/2fa-setup", forceLoad: true);
            return;
        }

        RedirectToLogin();
    }

    private void RedirectToLogin()
    {
        // ToBaseRelativePath returns a path without a leading slash ("details/5"), but
        // /signin only accepts return URLs that start with "/" — without the prefix the
        // endpoint silently discarded every returnUrl and always landed on /dashboard.
        // The value is also escaped so that a path carrying its own query string survives.
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = Uri.EscapeDataString($"/{relativePath}");

        NavigationManager.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
    }
}
