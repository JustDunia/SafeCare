@page "/account"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using SafeCare.Components.Layout
@using SafeCare.Data.Entities
@using SafeCare.Services
@using Serilog
@attribute [Authorize]
@inject UserManager<User> UserManager
@inject ITwoFactorService TwoFactorService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Ustawienia konta</PageTitle>

<MudStack Class="mt-4" Spacing="4" Style="max-width:500px">
    <MudText Typo="Typo.h5">Ustawienia konta</MudText>

    @if (isLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else
    {
        <MudCard Elevation="2">
            <MudCardHeader>
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Primary" Class="me-2" />
                <MudText>Powiadomienia e-mail</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Adres e-mail: <strong>@email</strong>
                </MudText>
                <MudSwitch T="bool"
                           @bind-Value="receiveEmailNotifications"
                           Color="Color.Primary"
                           Label="Otrzymuj powiadomienia e-mail o nowych zgłoszeniach" />
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="SaveAsync"
                           Disabled="isSaving">
                    Zapisz
                </MudButton>
            </MudCardActions>
        </MudCard>

        <MudCard Elevation="2">
            <MudCardHeader>
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Class="me-2" />
                <MudText>Weryfikacja dwuetapowa</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Logowanie wymaga kodu z aplikacji uwierzytelniającej.
                    Pozostałe kody odzyskiwania: <strong data-testid="recovery-code-count">@recoveryCodeCount</strong>
                </MudText>
                @if (newRecoveryCodes is not null)
                {
                    <RecoveryCodesList Codes="newRecoveryCodes" />
                }
                <MudText Typo="Typo.body2" Class="mt-3">
                    Zgubiony telefon? Zaloguj się kodem odzyskiwania albo poproś administratora o reset.
                </MudText>
            </MudCardContent>
            <MudCardActions Class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="RegenerateRecoveryCodesAsync"
                           Disabled="isSaving">
                    Wygeneruj nowe kody odzyskiwania
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           OnClick="RestartTwoFactorSetupAsync"
                           Disabled="isSaving">
                    Przenieś na nowy telefon
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudStack>

@code {
    [CascadingParameter]
    private MainLayout MainLayout { get; set; } = default!;

    private bool isLoading = true;
    private bool isSaving;
    private bool receiveEmailNotifications;
    private string email = string.Empty;
    private int recoveryCodeCount;
    private IReadOnlyList<string>? newRecoveryCodes;
    private User? user;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        MainLayout.SetPath("/account");
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            user = await UserManager.GetUserAsync(authState.User);

            if (user is not null)
            {
                email = user.Email ?? string.Empty;
                receiveEmailNotifications = user.ReceiveEmailNotifications;
                recoveryCodeCount = await TwoFactorService.CountRecoveryCodesAsync(user.Id);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to load user account settings.");
            Snackbar.Add("Nie udało się załadować ustawień konta.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (user is null) 
        {
            return;
        }

        isSaving = true;

        try
        {
            // Saved through a fresh scope and a freshly read user. The two-factor buttons on
            // this page change the account through TwoFactorService's own scopes, which leaves
            // the user loaded above with a stale concurrency stamp — updating it would fail.
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<User>>();
            var current = await userManager.FindByIdAsync(user.Id.ToString());
            if (current is null)
            {
                Snackbar.Add("Nie udało się zapisać ustawień.", Severity.Error);
                return;
            }

            current.ReceiveEmailNotifications = receiveEmailNotifications;
            var result = await userManager.UpdateAsync(current);

            if (result.Succeeded)
            {
                Snackbar.Add("Ustawienia zostały zapisane.", Severity.Success);
            }
            else
            {
                var errors = string.Join(", ", result.Errors.Select(e => e.Description));
                Log.Error("Failed to update user notification preference: {Errors}", errors);
                Snackbar.Add("Nie udało się zapisać ustawień.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Exception while saving user account settings.");
            Snackbar.Add("Nie udało się zapisać ustawień.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RegenerateRecoveryCodesAsync()
    {
        if (user is null)
        {
            return;
        }

        if (!await ConfirmAsync("Nowe kody odzyskiwania", "Dotychczasowe kody odzyskiwania przestaną działać. Kontynuować?", "Wygeneruj"))
        {
            return;
        }

        isSaving = true;
        try
        {
            newRecoveryCodes = await TwoFactorService.RegenerateRecoveryCodesAsync(user.Id);
            recoveryCodeCount = newRecoveryCodes.Count;
            Log.Information("User {UserName} regenerated recovery codes", user.UserName);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to regenerate recovery codes.");
            Snackbar.Add("Nie udało się wygenerować nowych kodów.", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RestartTwoFactorSetupAsync()
    {
        if (user is null)
        {
            return;
        }

        if (!await ConfirmAsync(
                "Przeniesienie na nowy telefon",
                "Kody z obecnej aplikacji przestaną działać od razu, a Ty przejdziesz do konfiguracji aplikacji na nowym telefonie. Kontynuować?",
                "Przejdź do konfiguracji"))
        {
            return;
        }

        isSaving = true;
        try
        {
            await TwoFactorService.RestartSetupAsync(user.Id);
            Log.Information("User {UserName} restarted two-factor setup", user.UserName);

            // A full load, so the setup page is authorized against a fresh request.
            NavigationManager.NavigateTo("/account/2fa-setup", forceLoad: true);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to restart two-factor setup.");
            Snackbar.Add("Nie udało się rozpocząć ponownej konfiguracji.", Severity.Error);
            isSaving = false;
        }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string confirmText)
    {
        var parameters = new DialogParameters
        {
            [nameof(ConfirmActionDialog.Message)] = message,
            [nameof(ConfirmActionDialog.ConfirmText)] = confirmText
        };

        var dialogRef = await DialogService.ShowAsync<ConfirmActionDialog>(title, parameters, new DialogOptions { CloseOnEscapeKey = true });
        var result = await dialogRef.Result;

        return result is { Canceled: false };
    }
}
