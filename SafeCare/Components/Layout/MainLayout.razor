@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SafeCare.Data
@using SafeCare.Data.Entities
@using Serilog
@inherits LayoutComponentBase
@inject UserManager<User> UserManager
@inject IDbContextFactory<AppDbContext> DbContextFactory

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="pb-5 pt-2">
    <MudAppBar Dense>
        <MudButton Class="white-text" Color="Color.Inherit" Href="https://udsk.pl/">
            <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="me-3" />
            <MudText>UDSK</MudText>
        </MudButton>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="authContext">
                @* MudMenu attaches no click handler to an ActivatorContent wrapper — a custom
                   activator has to call the MenuContext it receives. Using MudMenu's own button
                   activator (Label + EndIcon) instead keeps click and keyboard handling inside
                   the component and avoids nesting a <button> in the wrapper's role="button". *@
                <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                         Label="@($"{firstName} {lastName}")"
                         EndIcon="@Icons.Material.Filled.Person"
                         Color="Color.Inherit"
                         IconColor="Color.Inherit">
                    <ChildContent>
                        @if (isAdmin)
                        {
                            <MudMenuItem Href="/admin/users">Zarządzanie użytkownikami</MudMenuItem>
                        }
                        <MudMenuItem Href="/account">Ustawienia konta</MudMenuItem>
                        @* Signing out has to be a browser form POST — a circuit cannot clear the
                           auth cookie — so this item is a real submit button, not a MudMenuItem.
                           It carries MudMenuItem's own classes so it matches the items above:
                           mud-menu-item gives the layout and padding, mud-list-item-clickable the
                           button reset and hover, mud-ripple the ripple (MudBlazor's delegated
                           handler finds it with closest()), and MudText the typography a bare
                           <button> would otherwise take from the user agent. *@
                        <form method="post" action="/signout" id="logoutForm">
                            <button type="submit" class="mud-menu-item mud-list-item-clickable mud-ripple">
                                <MudText Class="mud-menu-item-text">Wyloguj</MudText>
                            </button>
                        </form>
                    </ChildContent>
                </MudMenu>
                @if (currentPath == "/")
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Href="/dashboard" Class="white-text" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Href="/" Class="white-text" />
                }
            </Authorized>
            <NotAuthorized>
                <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Href="/dashboard" Class="white-text" />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <CascadingValue Value="this">
            <MudContainer MaxWidth="MaxWidth.Large">
                @Body
            </MudContainer>
        </CascadingValue>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? authentication { get; set; }

    private string currentPath = "/";
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private bool isAdmin;

    public void SetPath(string path)
    {
        currentPath = path;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (authentication is not null)
        {
            var authState = await authentication;
            var user = authState.User;
            if (user.Identity is not null && user.Identity.IsAuthenticated)
            {
                // A context of its own, not the circuit's UserManager: the page inside this
                // layout initialises at the same moment, and a page that loads its user through
                // UserManager would otherwise share one DbContext with this query and fail with
                // "a second operation was started on this context".
                var userId = Guid.TryParse(UserManager.GetUserId(user), out var id) ? id : (Guid?)null;
                await using var dbContext = await DbContextFactory.CreateDbContextAsync();
                var userEntity = userId is null
                    ? null
                    : await dbContext.Users.AsNoTracking()
                        .Where(u => u.Id == userId)
                        .Select(u => new { u.FirstName, u.LastName })
                        .SingleOrDefaultAsync();

                if (userEntity is null)
                {
                    // The cookie is still valid but the account behind it is gone — an admin
                    // deleted it while this session was open. Throwing here would take down
                    // the layout, and with it every page. Render the shell without the user
                    // menu instead; Identity's security stamp validation signs the stale
                    // cookie out on its next check.
                    Log.Warning(
                        "Authenticated principal {UserName} has no matching user record; rendering layout without account details.",
                        user.Identity.Name);
                    return;
                }

                firstName = userEntity.FirstName;
                lastName = userEntity.LastName;
                // Roles are claims in the cookie, refreshed with the security stamp.
                isAdmin = user.IsInRole(AppRoles.Admin);
            }
        }
    }
}
